{
  "name": "iobroker.siemens-power",
  "version": "0.1.0",
  "description": "ioBroker adapter for Siemens 7KT PAC1600 energy meters (7KT1666) via Modbus RTU/TCP",
  "author": {
    "name": "MMeinhardt1"
  },
  "homepage": "https://github.com/MMeinhardt1/ioBroker.siemens-power",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "siemens",
    "7kt1666",
    "pac1600",
    "modbus",
    "energy-meter",
    "stromzaehler"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MMeinhardt1/ioBroker.siemens-power.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "modbus-serial": "^8.0.25"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.1"
  },
  "main": "main.js",
  "files": [
    "admin/",
    "lib/",
    "main.js",
    "io-package.json"
  ],
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "test:package": "mocha test/package.js --exit",
    "test:unit": "mocha test/unit.js test/logic.js --exit",
    "test:integration": "mocha test/integration.js --exit",
    "test": "npm run test:package && npm run test:unit",
    "lint": "eslint -c eslint.config.mjs .",
    "lint:fix": "eslint -c eslint.config.mjs . --fix",
    "check": "tsc -p tsconfig.check.json",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/MMeinhardt1/ioBroker.siemens-power/issues"
  }
}
