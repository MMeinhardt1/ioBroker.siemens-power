{
  "i18n": true,
  "type": "panel",
  "items": {
    "model": {
      "type": "select",
      "label": "Model",
      "options": [
        {
          "label": "Siemens 7KT1666 (PAC1600, 3-phasig, 80 A)",
          "value": "siemens-7kt1666"
        }
      ],
      "xs": 12,
      "sm": 12,
      "md": 8,
      "lg": 8,
      "xl": 8
    },
    "_hdrConn": {
      "type": "header",
      "text": "Connection",
      "size": 4,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "connectionType": {
      "type": "select",
      "label": "Connection type",
      "options": [
        {
          "label": "RTU over TCP (e.g. ESP bridge / stream_server)",
          "value": "tcprtu"
        },
        {
          "label": "Modbus TCP",
          "value": "tcp"
        },
        {
          "label": "Serial RS-485",
          "value": "serial"
        }
      ],
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "unitId": {
      "type": "number",
      "label": "Modbus unit ID",
      "min": 1,
      "max": 247,
      "xs": 12,
      "sm": 12,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "host": {
      "type": "text",
      "label": "IP address / host",
      "hidden": "data.connectionType === 'serial'",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "validator": "data.connectionType === 'serial' || /^((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)$/.test(data.host || '') || /^(?=.{1,253}$)(?!\\d+(\\.\\d+)*$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)*[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$/.test(data.host || '')",
      "validatorErrorText": "Please enter a valid IPv4 address (e.g. 192.168.1.10) or host name",
      "validatorNoSaveOnError": true
    },
    "port": {
      "type": "number",
      "label": "Port",
      "min": 1,
      "max": 65535,
      "hidden": "data.connectionType === 'serial'",
      "xs": 12,
      "sm": 12,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "serialPort": {
      "type": "text",
      "label": "Serial port",
      "hidden": "data.connectionType !== 'serial'",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "baudRate": {
      "type": "select",
      "label": "Baud rate",
      "hidden": "data.connectionType !== 'serial'",
      "options": [
        {
          "label": "1200",
          "value": 1200
        },
        {
          "label": "2400",
          "value": 2400
        },
        {
          "label": "4800",
          "value": 4800
        },
        {
          "label": "9600",
          "value": 9600
        },
        {
          "label": "19200",
          "value": 19200
        },
        {
          "label": "38400",
          "value": 38400
        }
      ],
      "xs": 12,
      "sm": 12,
      "md": 2,
      "lg": 2,
      "xl": 2
    },
    "parity": {
      "type": "select",
      "label": "Parity",
      "hidden": "data.connectionType !== 'serial'",
      "options": [
        {
          "label": "none",
          "value": "none"
        },
        {
          "label": "even",
          "value": "even"
        },
        {
          "label": "odd",
          "value": "odd"
        }
      ],
      "xs": 12,
      "sm": 12,
      "md": 2,
      "lg": 2,
      "xl": 2
    },
    "stopBits": {
      "type": "select",
      "label": "Stop bits",
      "hidden": "data.connectionType !== 'serial'",
      "options": [
        {
          "label": "1",
          "value": 1
        },
        {
          "label": "2",
          "value": 2
        }
      ],
      "xs": 12,
      "sm": 12,
      "md": 2,
      "lg": 2,
      "xl": 2
    },
    "_hdrPoll": {
      "type": "header",
      "text": "Polling",
      "size": 4,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "pollInterval": {
      "type": "number",
      "label": "Poll interval (s)",
      "min": 2,
      "max": 300,
      "xs": 12,
      "sm": 12,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "timeout": {
      "type": "number",
      "label": "Response timeout (ms)",
      "min": 300,
      "max": 10000,
      "xs": 12,
      "sm": 12,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "requestDelay": {
      "type": "number",
      "label": "Pause between requests (ms)",
      "min": 0,
      "max": 2000,
      "xs": 12,
      "sm": 12,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "retries": {
      "type": "number",
      "label": "Retries without answer",
      "min": 0,
      "max": 3,
      "xs": 12,
      "sm": 12,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "maxBlock": {
      "type": "number",
      "label": "Max. registers per request",
      "min": 2,
      "max": 32,
      "newLine": true,
      "help": "The 7KT1666 handles at most about 32",
      "xs": 12,
      "sm": 12,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "_hdrDiag": {
      "type": "header",
      "text": "Diagnostics",
      "size": 4,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "logRawValues": {
      "type": "checkbox",
      "label": "Log raw register values (debug)",
      "help": "Writes every received block as raw numbers at log level debug. Only for troubleshooting – produces many log lines.",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    }
  }
}